# MongoDB Atlas connection string (or mongodb://localhost:27017/?replicaSet=rs0 for a local replica set).
# Transactions are used for every state change, so the server must be a replica set — Atlas always is.
MONGODB_URI=
MONGODB_DB=limonar

# Signs session tokens. Generate one with: openssl rand -base64 48
AUTH_SECRET=

# How long a sign-in lasts.
SESSION_DAYS=30

# PIN given to every seeded user (npm run seed).
SEED_PIN=1234
